{
	"name": "backend",
	"version": "1.0.0",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"backend": "nodemon --env-file=.env server",
		"frontend": "cd ../frontend && npm run dev",
		"ml": "../venv/bin/python ../ml-service/src/app.py",
		"rasa": "cd ../chatbot && ../rasa_env/bin/python -m rasa run --enable-api --debug --cors \"*\"",
		"actions": "cd ../chatbot && ../rasa_env/bin/python -m rasa run actions --debug",
		"rasa-train": "cd ../chatbot && ../rasa_env/bin/python -m rasa train",
		"dev": "concurrently --kill-others \"npm run rasa\" \"npm run actions\" \"npm run backend\" \"npm run ml\" \"npm run frontend\""
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"devDependencies": {
		"concurrently": "^9.2.1",
		"dotenv": "^17.3.1",
		"nodemon": "^3.1.11"
	},
	"dependencies": {
		"cors": "^2.8.6",
		"cross-env": "^10.1.0",
		"express": "^5.2.1",
		"flask-cors": "^0.0.1",
		"mongoose": "^9.2.2",
		"shap": "^1.1.3"
	}
}
